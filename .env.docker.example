# Copy this to .env and fill in real values before `docker compose up`.
# This file (.env.docker.example) is safe to commit -- it has no real secrets.
# .env itself is gitignored and must never be committed.

# --- Required for a real deployment ---
# Django's own message-signing key. The current local dev default
# ("django-insecure-fallback-...") is INSECURE and must be overridden for any real
# deployment -- generate a real one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Must be "False" for any real deployment. The local dev default is "True" -- do not
# rely on that default here.
DEBUG=False

# The real domain/hostname this deployment is reached at (comma-separated for more
# than one), e.g. "planning.example.com". Django rejects requests with any other Host
# header. localhost/127.0.0.1/testserver are always allowed regardless of this.
ALLOWED_HOSTS_EXTRA=

# --- Redshift (live data pulls -- Data Normalization Agent, Routing, Pitching) ---
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_DB_DEV=dev
REDSHIFT_DB_INPUT_BACKEND=input_backend_db
REDSHIFT_DB_LOCUS=locus

# --- LLM providers (Plan C routing + AI-Generated Pitch) ---
LLM_ROUTING_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Google Maps (route/distance accuracy -- optional, falls back to Haversine x1.4
# if unset) ---
GOOGLE_API_KEY=

# --- Discount Service / coupon-service (optional -- real scheme eligibility) ---
DISCOUNT_SERVICE_BASE_URL=
DISCOUNT_SERVICE_CLIENT_ID=
DISCOUNT_SERVICE_CLIENT_SECRET=

# --- Product Cohort integration (optional -- Focus Product Campaign Targeting) ---
PRODUCT_COHORT_URL=
PRODUCT_COHORT_SESSION=
PRODUCT_COHORT_GO_ADMIN_SESSION=

# --- DC Farmer Mapping integration (optional) ---
DC_FARMER_MAPPING_URL=
DC_FARMER_MAPPING_SESSION=
DC_FARMER_MAPPING_GO_ADMIN_SESSION=

# --- Alerting (optional -- exceeded-threshold/failure notifications) ---
ALERT_WEBHOOK_URL=

# --- Celery broker -- set automatically by docker-compose.yml's `environment:` block
# for every service (redis://redis:6379/0, the in-network service name, not
# localhost) -- do not set this here, docker-compose's own value always wins.
# CELERY_BROKER_URL=
