{
  "info": {
    "_postman_id": "bd752809-413c-43d1-ae11-0b735e41c7fb",
    "name": "Product Cohort \u2014 /sps/v1/fp",
    "description": "Focus Product Cohort wizard APIs (`product_cohort_ui.html`).\n\n**Flow:** `01 \u00b7 Auth \u2192 Go Admin Sign in` \u2192 then Step 1\u20133 requests.\n\nEnv: `PC_*_url`, `go_admin_username`, `go_admin_password`, `fp_session`, `go_admin_session`.\nSample filters are literal in each request \u2014 edit there, not in env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 \u00b7 Auth",
      "description": "Sign in first; session auto-saved to env.",
      "item": [
        {
          "name": "Go Admin Sign in (save session)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = pm.environment.get('go_admin_username') || '';",
                  "const p = pm.environment.get('go_admin_password') || '';",
                  "if (!u.trim() || !p.trim()) {",
                  "  throw new Error('Set go_admin_username and go_admin_password in environment CURRENT values (not Initial only).');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Capture Go Admin session \u2192 fp_session / go_admin_session",
                  "function pickSession() {",
                  "  try { const c = pm.cookies.get('go_admin_session'); if (c) return c; } catch (e) {}",
                  "  const cookies = pm.response.headers.all()",
                  "    .filter(h => String(h.key).toLowerCase() === 'set-cookie')",
                  "    .map(h => h.value).join('; ');",
                  "  let m = cookies.match(/go_admin_session=([^;]+)/i);",
                  "  if (m) return m[1].trim();",
                  "  const one = pm.response.headers.get('Set-Cookie') || '';",
                  "  m = one.match(/go_admin_session=([^;]+)/i);",
                  "  return m ? m[1].trim() : '';",
                  "}",
                  "const sid = pickSession();",
                  "if (sid) {",
                  "  pm.environment.set('fp_session', sid);",
                  "  pm.environment.set('go_admin_session', sid);",
                  "  console.log('Saved fp_session =', sid);",
                  "  pm.test('Session saved to environment', () => pm.expect(sid.length).to.be.above(10));",
                  "} else {",
                  "  pm.test('Session saved to environment', () => pm.expect.fail('No go_admin_session in response'));",
                  "}",
                  "pm.test('Signin HTTP ok', () => pm.expect([200, 302, 301]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{go_admin_username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{go_admin_password}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{PC_feature_url}}/admin/signin",
            "description": "Run first. Requires `product_cohort_user` role.\n\nSet **Current value** for `go_admin_username` / `go_admin_password` in the **Product Cohort** env."
          },
          "response": []
        },
        {
          "name": "Auth probe \u2014 focus-product options",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-FP-Session",
                "value": "{{fp_session}}",
                "type": "text",
                "description": "Filled by Sign in Tests script"
              },
              {
                "key": "Cookie",
                "value": "go_admin_session={{go_admin_session}}",
                "type": "text"
              }
            ],
            "url": "{{PC_feature_url}}/sps/v1/fp/focus-product/options",
            "description": "Same check as UI on page load (pcCheckAuth)."
          },
          "response": []
        }
      ]
    },
